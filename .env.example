# ==========================================
# AetherMail Production Environment Variables
# ==========================================

# Database Connection (PostgreSQL / Neon / Supabase / Vercel Postgres)
# Required for persistent production storage across serverless function invocations
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Authentication & Session Security
# Secret string used to sign sessions and salt password hashes
AUTH_SECRET=your_super_secret_auth_encryption_key_here

# Initial Administrator Credentials (provisioned automatically if admin does not exist)
INITIAL_ADMIN_EMAIL=admin@aethermail.cx
INITIAL_ADMIN_PASSWORD=SetAStrongAdminPassword2026!

# Inbound Email Provider & Relay Configuration
# Supported providers: mailtm, inboxes, guerrillamail, custom_api, native
EMAIL_PROVIDER=mailtm
EMAIL_API_URL=https://api.mail.tm
EMAIL_API_KEY=
EMAIL_DOMAIN=

# Inbound Email Webhook Authentication Secret
# Used by external mail parsers (CloudMailin, SendGrid, Mailgun, Postmark, AWS SES)
# Send as header 'x-webhook-secret: <secret>' or '?secret=<secret>'
WEBHOOK_SECRET=your_inbound_webhook_secret_key

# Vercel Scheduled Cron Secret
# Used to authenticate automated cleanup executions from Vercel Crons
CRON_SECRET=your_vercel_cron_secret_token

# Public Application URLs (for canonical sitemaps and links)
NEXT_PUBLIC_APP_URL=https://your-aethermail.vercel.app
APP_URL=https://your-aethermail.vercel.app
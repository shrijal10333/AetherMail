# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Real Inbound Disposable Email Provider Configuration
# Supported providers:
# - "mailtm" (default: uses live api.mail.tm public disposable MX network)
# - "custom_api" (custom email provider API)
EMAIL_PROVIDER="mailtm"
EMAIL_API_KEY=""
EMAIL_API_URL="https://api.mail.tm"
EMAIL_DOMAIN=""

# Initial Administrator Account Configuration (seeded once securely on server startup)
INITIAL_ADMIN_EMAIL="admin@aethermail.cx"
INITIAL_ADMIN_PASSWORD="MY_INITIAL_ADMIN_PASSWORD"

